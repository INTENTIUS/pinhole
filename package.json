{
  "name": "@intentius/pinhole",
  "version": "0.6.0",
  "type": "module",
  "description": "Agentic infra diagrammer — paints chant's graph IR into diagrams, gated by lint at every step",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pinhole": "./bin/pinhole.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./chant": {
      "types": "./dist/chant.d.ts",
      "default": "./dist/chant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "gen:agents": "node --experimental-strip-types -e \"import('./src/guide.ts').then(m=>process.stdout.write(m.GUIDE))\" > AGENTS.md",
    "build:lib": "esbuild src/index.ts src/icons.ts src/chant.ts --bundle --splitting --platform=node --format=esm --external:@intentius/chant --outdir=dist",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --external:@intentius/chant --outfile=dist/cli.js && chmod +x dist/cli.js",
    "build:types": "tsc -p tsconfig.build.json",
    "check:browser": "esbuild src/index.ts --bundle --platform=browser --format=esm --minify --log-level=warning --outfile=/dev/null",
    "build": "rm -rf dist && npm run build:lib && npm run build:cli && npm run build:types",
    "prepublishOnly": "npm run build",
    "workflows": "npx chant build ci -o .github/workflows/ci.yml --format yaml && npx chant release workflow --forge github",
    "generated-check": "chant dev generated-check"
  },
  "chantGenerated": {
    "regenerate": "npm run workflows",
    "renders": [
      {
        "name": "ci",
        "run": "npx chant build ci -o {out}/.github/workflows/ci.yml --format yaml",
        "files": [
          ".github/workflows/ci.yml"
        ]
      },
      {
        "name": "publish",
        "run": "npx chant release workflow --forge github",
        "files": [
          ".github/workflows/publish.yml"
        ]
      }
    ]
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@intentius/chant": "^0.124.105"
  },
  "devDependencies": {
    "@intentius/chant-lexicon-github": "0.124.101",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTENTIUS/pinhole.git"
  },
  "bugs": {
    "url": "https://github.com/INTENTIUS/pinhole/issues"
  },
  "homepage": "https://github.com/INTENTIUS/pinhole#readme"
}
